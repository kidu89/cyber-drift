    <button class="tab" data-tab="controls" role="tab"><svg viewBox="0 0 24 24"><path d="M7.5 7.5h9a4.5 4.5 0 0 1 4.4 5.4l-.8 4a2.5 2.5 0 0 1-4.3 1.2L13.6 16h-3.2l-2.2 2.1a2.5 2.5 0 0 1-4.3-1.2l-.8-4a4.5 4.5 0 0 1 4.4-5.4z"/><path d="M8 10.5v3M6.5 12h3"/><circle cx="15.8" cy="11" r=".5"/><circle cx="17.3" cy="13" r=".5"/></svg>Controls</button>
    <button class="tab" data-tab="credits" role="tab"><svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></svg>Credits</button>
