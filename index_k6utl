    <button id="resume" type="button">Resume driving</button>
  </nav>
  <div id="setPane">
    <div id="setHead"><h2 id="setTitle">Autopilot</h2><button id="setX" type="button" aria-label="Close (Esc)" title="Close (Esc)">&times;</button></div>

    <section class="sec" data-sec="autopilot">
      <h3>Driving level <span class="hk">I · pad: d-pad down</span></h3>
      <div class="seg lvl" role="radiogroup" aria-label="Driving level">
        <button data-level="manual" role="radio" aria-checked="true">Manual<small>No assist</small></button>
        <button data-level="l3" role="radio" aria-checked="false">L3<small>Guidance</small></button>
        <button data-level="l4" role="radio" aria-checked="false">L4<small>Lane · cruise</small></button>
        <button data-level="l5" role="radio" aria-checked="false">L5<small>Self-driving</small></button>
      </div>
      <p class="note" id="lvlNote"></p>
      <h3>Level 5</h3>
      <div class="row stack"><span class="t">Driving profile<small>Mad Max: assertive - over the limit, passes slower cars, late firm braking. Chill: relaxed</small></span>
        <div class="seg" role="radiogroup" aria-label="L5 profile"><button data-l5profile="chill" role="radio">Chill</button><button data-l5profile="madmax" role="radio">Mad Max</button></div></div>
      <button class="row sw" data-dassist-all aria-pressed="false"><span class="t">Same level for every car<small>Off: each car keeps its own (every car starts on Manual)</small></span><b>OFF</b></button>
    </section>

    <section class="sec" data-sec="driving">
      <h3>Stability assists</h3>
      <button class="row sw" data-assist="abs" aria-pressed="true"><span class="t">ABS<small>Modulates the brakes to prevent wheel lock</small></span><b>ON</b></button>
      <button class="row sw" data-assist="tcs" aria-pressed="true"><span class="t">Traction control (TCS)<small>Limits driven-wheel spin</small></span><b>ON</b></button>
      <button class="row sw" data-assist="esp" aria-pressed="true"><span class="t">Stability control (ESP)<small>Brakes individual wheels to control skids</small></span><b>ON</b></button>
      <button class="row sw" data-assist="steering" aria-pressed="true"><span class="t">Steering helper<small>Smooths turn-in and corrects steering</small></span><b>ON</b></button>
      <h3>Transmission</h3>
      <div class="row"><span class="t">Gearbox<small>Automatic, or shift yourself<span id="manualHint">: Z / X or LB / RB down / up, brake to reverse; unsafe downshifts are blocked</span></small></span>
        <div class="seg inl" role="radiogroup" aria-label="Gearbox"><button data-transmission="auto" role="radio">Automatic</button><button data-transmission="manual" role="radio">Manual</button></div></div>
      <h3>Braking line</h3>
      <div class="row"><span class="t">Braking line<small>Chevrons on the road: green, orange to brake, red too fast · in races, always (Manual too), or never</small></span>
        <div class="seg inl" role="radiogroup" aria-label="Braking line"><button data-pref="brakeLine" data-v="races" role="radio">Races</button><button data-pref="brakeLine" data-v="always" role="radio">Always</button><button data-pref="brakeLine" data-v="off" role="radio">Off</button></div></div>
      <h3>Units</h3>
      <div class="row"><span class="t">Speed<small>The speedometer and the distances · U · Auto: the city's own</small></span>
        <div class="seg inl" role="radiogroup" aria-label="Speed units"><button data-units="auto" role="radio">Auto</button><button data-units="mph" role="radio">mph</button><button data-units="kmh" role="radio">km/h</button></div></div>
    </section>

    <section class="sec" data-sec="vehicle">
      <h3 class="tele">Your car</h3>
      <button class="row tele" id="vehicleBtn"><span class="t">Change vehicle<small>Choose your FSD: five cars, from the Waymo to the Cybertruck</small></span><b class="v">Waymo</b><i class="chev"></i></button>
      <button class="row" id="garageBtn"><span class="t">Customize<small>The garage: paint, finish, calipers and wheels on the turntable</small></span><i class="chev"></i></button>
      <button class="row sw tele" id="faresBtn" aria-pressed="true"><span class="t">Fares<small>Off: free roam - drive anywhere, no passengers</small></span><b>ON</b></button>
      <div class="row wmoOnly"><span class="t">Ride style<small>Street: speed, skill and heat build a bounty · Comfort: smooth rides tip</small></span>
        <div class="seg inl" role="radiogroup" aria-label="Ride style"><button data-ridestyle="street" role="radio">Street</button><button data-ridestyle="comfort" role="radio">Comfort</button></div></div>
      <h3 class="modeH">Mode</h3>
      <button class="row" data-mode-switch><span class="t">Game mode<small>Free roam in the Ferrari · Waymo taxi: pick up fares - reloads</small></span><b class="v">Free roam</b><i class="chev"></i></button>
    </section>

    <section class="sec" data-sec="display">
      <h3>Time of day <span class="hk">T key</span></h3>
      <div class="seg" role="radiogroup" aria-label="Time of day">
        <button data-tod="noon" role="radio">Sunny</button><button data-tod="golden" role="radio">Golden hour</button><button data-tod="fog" role="radio">Fog</button><button data-tod="rain" role="radio">Rain</button><button data-tod="dusk" role="radio">Blue hour</button><button data-tod="night" role="radio">Night</button>
      </div>
      <p class="note">The light and the weather<span class="shared">shared with the room</span></p>
      <h3>Camera <span class="hk">C key</span></h3>
      <div class="seg" role="radiogroup" aria-label="Camera view">
        <button data-cam="0" role="radio">Chase</button><button data-cam="1" role="radio">Far chase</button><button data-cam="2" role="radio">Hood</button><button data-cam="3" role="radio">Bumper</button>
      </div>
      <h3>Photo mode <span class="hk">F key</span></h3>
      <button class="row" id="photoBtn"><span class="t">Photo mode<small>The drive frozen, a free camera round the car, the look - field of view, exposure, depth blur, filters - and a PNG to save</small></span><i class="chev"></i></button>
      <h3>Motion blur</h3>
      <div class="seg" role="radiogroup" aria-label="Motion blur"><button data-pref="blur" data-v="subtle" role="radio">Subtle<small>Crisp at city and highway speeds</small></button><button data-pref="blur" data-v="forza" role="radio">Forza<small>The edges streak from ~80 km/h</small></button></div>
      <h3>Camera vibration</h3>
      <div class="seg" role="radiogroup" aria-label="Camera vibration"><button data-pref="vibe" data-v="on" role="radio">On<small>The road felt at speed and off it</small></button><button data-pref="vibe" data-v="off" role="radio">Off<small>A steady camera</small></button></div>
      <h3>HUD</h3>
      <div class="seg" role="radiogroup" aria-label="HUD"><button data-pref="hud" data-v="full" role="radio">Full<small>Map, speed, aids</small></button><button data-pref="hud" data-v="min" role="radio">Minimal<small>Map and speed</small></button><button data-pref="hud" data-v="off" role="radio">Off<small>Just the road</small></button></div>
    </section>

    <section class="sec" data-sec="graphics">
      <h3>Graphics quality</h3>
      <div class="rlist" role="radiogroup" aria-label="Graphics quality">
        <button class="radio" data-gfx="auto" role="radio"><span class="t">Auto<small>What this device runs best</small></span><b></b></button>
        <button class="radio" data-gfx="saver" role="radio"><span class="t">Battery saver<small>Small city round the car, 0.6 resolution, no shadows: coolest</small></span><b></b></button>
        <button class="radio" data-gfx="mobile" role="radio"><span class="t">Mobile<small>Lighter city and textures, 1k shadows: phones and tablets</small></span><b></b></button>
        <button class="radio" data-gfx="perf" role="radio"><span class="t">Performance<small>The full city at 1x resolution, 2k shadows, no reflections</small></span><b></b></button>
        <button class="radio" data-gfx="high" role="radio"><span class="t">High<small>Up to 1.75x resolution, 4k shadows, street reflections</small></span><b></b></button>
        <button class="radio" data-gfx="ultra" role="radio"><span class="t">Ultra<small>Native resolution (2x), 4k shadows and sky, far reflections</small></span><b></b></button>
      </div>
      <div id="gfxAsk" role="alertdialog" aria-live="polite"><span></span><button type="button" id="gfxGo">Restart now</button><button type="button" id="gfxNo">Later</button></div>
      <p id="gfxNote"></p>
      <h3>Frame rate</h3>
      <div class="seg" role="radiogroup" aria-label="Frame rate">
        <button data-fps="30" role="radio">30 FPS<small>Cool and steady</small></button>
        <button data-fps="60" role="radio">60 FPS<small>Smoother, warmer</small></button>
        <button data-fps="0" role="radio">Uncapped<small>The display's rate</small></button>
      </div>
    </section>

    <section class="sec" data-sec="sound">
      <h3>Volume</h3>
      <div class="row stack"><span class="t">Master volume</span><b class="v" id="masterVolV">100</b>
        <div class="slide"><svg viewBox="0 0 24 24"><path d="M5 9.5h3.5L13 5.5v13l-4.5-4H5z"/></svg><input id="masterVol" type="range" min="0" max="100" step="5" value="100" aria-label="Master volume"><svg viewBox="0 0 24 24"><path d="M3 9.5h3.5L11 5.5v13l-4.5-4H3z"/><path d="M14.5 9a4 4 0 0 1 0 6M17 6.5a7.5 7.5 0 0 1 0 11"/></svg></div></div>
      <h3>Music</h3>
      <button class="row sw" data-music aria-pressed="true"><span class="t">Music<small>The radio · L: station · K: next track</small></span><b>ON</b></button>
      <div class="row stack"><span class="t">Music volume</span><b class="v" id="musicVolV">70</b>
        <div class="slide"><svg viewBox="0 0 24 24"><path d="M5 9.5h3.5L13 5.5v13l-4.5-4H5z"/></svg><input id="musicVol" type="range" min="0" max="100" step="5" value="70" aria-label="Music volume"><svg viewBox="0 0 24 24"><path d="M3 9.5h3.5L11 5.5v13l-4.5-4H3z"/><path d="M14.5 9a4 4 0 0 1 0 6M17 6.5a7.5 7.5 0 0 1 0 11"/></svg></div></div>
      <div class="btns"><button class="pbtn" type="button" id="radioStation">Station: Horizon Mix</button><button class="pbtn" type="button" id="nextTrack">Next track</button></div>
    </section>

    <section class="sec" data-sec="world">
      <h3>Streets<span class="shared">traffic and parked cars shared with the room</span></h3>
      <button class="row sw" id="trafficBtn" aria-pressed="true"><span class="t">Traffic<small>Off: no moving cars, buses, cable cars or streetcars</small></span><b>ON</b></button>
      <button class="row sw" id="parkedBtn" aria-pressed="true"><span class="t">Parked cars<small>Off: empty kerbs</small></span><b>ON</b></button>
      <h3>Discovery</h3>
      <div class="row"><span class="t" id="discRoads">Roads discovered<small id="discRoadsS">Drive a street to discover it: the map traces them</small></span><b class="v" id="discRoadsV">0 %</b></div>
      <div class="row"><span class="t">Boards smashed<small id="discBoardsS">XP and fast-travel boards at the viewpoints: drive through them</small></span><b class="v" id="discBoardsV">0 / 0</b></div>
      <h3>Life and activities</h3>
      <button class="row sw" data-pref="peds" aria-pressed="true"><span class="t">Pedestrians<small>People on the sidewalks · applies on the next start</small></span><b>ON</b></button>
      <button class="row sw" data-pref="guide" aria-pressed="true"><span class="t">What's next<small>The nearest stunt or board not done yet, its route on the maps (free roam)</small></span><b>ON</b></button>
      <button class="row sw" data-pref="stunts" aria-pressed="true"><span class="t">PR stunts<small>Speed traps, speed zones, drift zones, danger signs: the beacons, the map's badges, the scores</small></span><b>ON</b></button>
      <h3>Police</h3>
      <button class="row sw" id="policeBtn" aria-pressed="true"><span class="t">Police<small>Patrol cars and pursuits when cruising (never in a race) · Off: no police</small></span><b>ON</b></button>
    </section>

    <section class="sec mpOnly" data-sec="room">
      <h3>Drive together</h3>
      <div class="row"><span class="t" id="setRoomName">Not in a room<small id="setRoomStat">Open a room and send the link. Up to 8 drivers.</small></span></div>
      <button class="row" id="setRoomOpen"><span class="t">Room panel<small>Open a room, copy the invite link, see who is driving, go to them</small></span><i class="chev"></i></button>
      <p class="note">Traffic, parked cars and the time of day are the same for everybody in a room.</p>
    </section>

    <section class="sec profOnly" data-sec="profile">
      <div class="acWrap" data-acchip></div>
      <div class="row spRow"><span class="t">AI spending limit<small>Ask me again before more than this many AI generations in a session</small></span><select id="spendCap" aria-label="AI generations a session before asking again"><option>1</option><option>3</option><option>5</option><option>10</option><option>20</option></select></div>
      <p class="note" id="spendLife"></p>
      <h3>Your record</h3>
      <div class="stats" id="setStats"></div>
      <p class="note" id="setStatsNote"></p>
    </section>

    <section class="sec profOnly" data-sec="leaderboard">
      <h3>Every driver</h3>
      <div class="seg" role="radiogroup" aria-label="Board"><button type="button" role="radio" data-lb="cash">Cash</button><button type="button" role="radio" data-lb="races_won">Races won</button><button type="button" role="radio" data-lb="best_bounty">Bounty</button><button type="button" role="radio" data-lb="longest_drift">Drift</button><button type="button" role="radio" data-lb="xp">Level</button></div>
      <div class="acWrap" data-acchip></div>
      <ol class="lb" id="lbList"></ol>
      <div class="btns"><button class="pbtn" id="lbMore" type="button" hidden>Show more</button></div>
      <p class="note" id="lbNote"></p>
    </section>

    <section class="sec" data-sec="controls">
      <h3>Gamepad</h3>
      <button class="row sw" data-pref="rumble" aria-pressed="true"><span class="t">Rumble<small>The pad shakes on hits, kerbs, drifts, landings and ABS (where the browser supports it)</small></span><b>ON</b></button>
      <div class="row stack"><span class="t">Steering sensitivity<small>The stick's response: low - gentle near the centre, high - quick</small></span><b class="v" id="steerSensV">50</b>
        <div class="slide"><input type="range" min="0" max="100" step="5" value="50" data-prefnum="steerSens" aria-label="Steering sensitivity"></div></div>
      <div class="row stack"><span class="t">Stick deadzone<small>How far the stick moves before it steers</small></span><b class="v" id="deadzoneV">12</b>
        <div class="slide"><input type="range" min="0" max="30" step="1" value="12" data-prefnum="deadzone" data-unit=" %" aria-label="Stick deadzone"></div></div>
      <h3>Camera</h3>
      <div class="row stack"><span class="t">Field of view<small>Wider or narrower than the camera's own (degrees)</small></span><b class="v" id="fovAddV">0</b>
        <div class="slide"><input type="range" min="-10" max="20" step="1" value="0" data-prefnum="fovAdd" data-unit="°" aria-label="Field of view"></div></div>
      <h3>Controls</h3>
      <div class="keys" id="setKeys"></div>
      <h3>Help</h3>
      <div class="btns"><button class="pbtn" data-act="help" type="button">Show the controls card (H)</button><button class="pbtn" id="introBtn" type="button">Replay the intro</button></div>
    </section>

    <section class="sec" data-sec="credits"></section>
  </div>
</div></div>

